# Copy this file to .env and fill it in. Never commit .env.

# --- Required ---
HELIUS_API_KEY=your-helius-api-key
# Base58 secret key of a wallet used ONLY for this bot. Keep little SOL in it.
PRIVATE_KEY=

# --- Safety: starts in dry-run. Set to false only after watching it simulate for a while. ---
DRY_RUN=true

# --- Helius endpoints (defaults are London; pick the region nearest your server) ---
# LaserStream mainnet needs a Helius Business or Professional plan.
# GRPC_ENDPOINT=https://laserstream-mainnet-lon.helius-rpc.com
# GRPC_TOKEN=            # defaults to HELIUS_API_KEY
# RPC_URL=               # defaults to https://mainnet.helius-rpc.com/?api-key=HELIUS_API_KEY
# SENDER_URL=http://lon-sender.helius-rpc.com/fast

# --- Trade size and costs ---
BUY_SOL=0.01
# Helius Sender tip. 0.001 SOL is the Sender Max minimum; lower tips (>= 0.000005) go via a single path.
BUY_TIP_SOL=0.001
SELL_TIP_SOL=0.0001
PRIORITY_FEE_MICROLAMPORTS=200000
COMPUTE_UNIT_LIMIT=200000
BUY_SLIPPAGE_BPS=2000
SELL_SLIPPAGE_BPS=1500
FEE_BUFFER_BPS=100

# --- Spending limits ---
MAX_SOL_PER_TRADE=0.05
MAX_SOL_PER_DAY=0.5
MAX_OPEN_POSITIONS=3
MIN_WALLET_RESERVE_SOL=0.02

# --- Exits ---
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
MAX_HOLD_SECONDS=300
POSITION_POLL_MS=1500

# --- Launch filters ---
MAX_DEV_BUY_PCT=10
SKIP_MAYHEM=true
SNIPE_LEGACY_CREATE=true
# Comma-separated wallet addresses / words
BLOCKED_CREATORS=
NAME_BLOCKLIST=

# --- Pipeline ---
SNIPE_CONCURRENCY=2
MAX_QUEUE=20
MAX_SIGNAL_AGE_MS=2500
DEDUPE_TTL_MS=600000
# STATE_FILE=state/state.json
